/*
 * HUD base styles on the Glass Clearing tokens (UI/Tokens.uss): the root, buttons (.act), fields, scrollers,
 * meters and the content classes the drawer sections still build with. The chrome lives in UI/Chrome.uss
 * and the drawer frame in UI/Drawer.uss. The legacy .top, .navigation, .bottom and .view-controls bars are
 * gone: the map is full bleed.
 */
#forest-ui {
    flex-grow: 1;
    color: var(--ink);
    font-size: var(--size-body);
    -unity-font-definition: url("UI/Fonts/Manrope-SemiBold.ttf");
    -unity-font-style: normal;
}

/* ---- Buttons: verb first, sentence case (GUIDE .act) ---------------------------------------------- */
.unity-button {
    flex-shrink: 0;
    min-height: 30px;
    padding: 6px 11px;
    margin: 3px 0;
    color: var(--ink);
    background-color: var(--fill);
    background-image: none;
    border-width: 1px;
    border-color: var(--edge);
    border-radius: var(--radius-button);
    -unity-font-definition: url("UI/Fonts/Manrope-ExtraBold.ttf");
    -unity-font-style: normal;
    font-size: var(--size-button);
    white-space: normal;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.unity-button:hover {
    background-color: var(--fill-hover);
    border-color: rgba(255, 255, 255, 0.07);
}

.unity-button:active {
    scale: 0.96 0.96;
}

.unity-button.active {
    background-color: var(--sun-tint);
    border-color: var(--sun);
    color: var(--ink);
}

.unity-button:disabled {
    opacity: 0.45;
}

.unity-button.primary, .unity-button.hot {
    background-color: var(--sun);
    border-color: rgba(0, 0, 0, 0);
    color: var(--sun-ink);
}

.unity-button.primary:hover, .unity-button.hot:hover {
    background-color: #ffdc85;
}

.unity-button.quiet {
    background-color: rgba(0, 0, 0, 0);
}

.reduced-motion .unity-button {
    transition-duration: 0s;
}

.reduced-motion .unity-button:active {
    scale: 1 1;
}

.row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.row > .unity-button {
    margin-right: 6px;
}

/* ---- Text roles ----------------------------------------------------------------------------------- */
.title {
    -unity-font-definition: url("UI/Fonts/Manrope-ExtraBold.ttf");
    font-size: var(--size-title);
    color: var(--ink);
    white-space: normal;
}

.body {
    white-space: normal;
    margin-top: 4px;
    margin-bottom: 6px;
    color: var(--ink);
    font-size: var(--size-body);
}

/* Section subtitles are headings, not actions: ink, never sun (GUIDE §3 colour rule). */
.subtitle {
    -unity-font-definition: url("UI/Fonts/Manrope-ExtraBold.ttf");
    font-size: 13.5px;
    white-space: normal;
    margin-top: 10px;
    margin-bottom: 6px;
    color: var(--ink);
}

.muted {
    color: var(--dim);
    white-space: normal;
    font-size: var(--size-caption);
    margin: 3px 0;
}

.warning {
    color: var(--bad);
    -unity-font-definition: url("UI/Fonts/Manrope-Bold.ttf");
    white-space: normal;
    margin: 6px 0;
    padding: 6px 10px;
    border-width: 1px;
    border-color: rgba(255, 107, 87, 0.12);
    border-radius: var(--radius-box);
    background-color: var(--bad-tint);
}

.eyebrow {
    -unity-font-definition: url("UI/Fonts/Manrope-ExtraBold.ttf");
    font-size: var(--size-label);
    letter-spacing: 1.2px;
    color: var(--dim);
}

/* ---- Section content (legacy builders, retokened until the W3 drawers replace them) --------------- */
.card {
    padding: 10px 12px 12px 12px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: var(--radius-box);
    background-color: var(--fill);
}

.card > .subtitle {
    margin-top: 2px;
}

.card-heading {
    justify-content: space-between;
}

.card-heading > .subtitle {
    flex-grow: 1;
    flex-shrink: 1;
}

.card-heading > .unity-button {
    margin-left: 8px;
}

.research-cards {
    flex-direction: row;
    flex-wrap: wrap;
}

.research-card {
    width: 280px;
    min-height: 220px;
    padding: 14px;
    margin: 6px;
    border-radius: var(--radius-box);
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--fill);
}

.research-card.complete {
    border-color: var(--ok);
    background-color: rgba(126, 211, 122, 0.02);
}

.research-card.locked {
    opacity: 0.7;
}

.research-card > .unity-button {
    margin-top: 8px;
}

.separator {
    height: 1px;
    background-color: var(--line);
    margin: 14px 0 10px 0;
}

.stock-row {
    padding: 7px 1px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.work-position {
    padding: 10px 12px;
    margin: 8px 0;
    border-radius: var(--radius-box);
    background-color: var(--fill);
    border-left-width: 3px;
    border-left-color: var(--ok);
}

.queue-entry {
    padding: 8px 0;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.queue-entry > .subtitle {
    margin-top: 2px;
}

.queue-entry .row > .unity-button {
    min-height: 28px;
    padding: 4px 9px;
}

.need-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 6px -3px;
}

.need-grid > .unity-progress-bar {
    width: 47%;
    margin: 4px;
}

.labor-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.labor-grid > Toggle {
    width: 47%;
}

/* The W1 tethered card stub; W2-14 replaces it with UI/Card.uss. */
.tethered-inspector {
    position: absolute;
    width: 300px;
    min-height: 100px;
    padding: 14px;
    background-color: var(--glass);
    border-width: 1px;
    border-color: var(--edge);
    border-radius: var(--radius-panel);
}

.tethered-inspector > .unity-button {
    align-self: flex-start;
}

/* ---- Fields: glass inputs with a sun focus ring (GUIDE §11) --------------------------------------- */
.unity-base-field {
    margin: 6px 0;
    min-height: 30px;
    color: var(--ink);
}

.unity-base-field__label {
    min-width: 100px;
    max-width: 140px;
    white-space: normal;
    color: var(--dim);
    font-size: var(--size-caption);
}

.unity-base-field__input {
    background-color: var(--well);
    color: var(--ink);
    border-width: 1px;
    border-color: var(--edge);
    padding: 5px 8px;
    border-radius: 8px;
    font-size: var(--size-body);
}

.unity-base-field:focus .unity-base-field__input, .unity-base-text-field__input:focus {
    border-width: 2px;
    border-color: var(--sun);
}

.unity-toggle__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ---- Scrollers: one thin bar, no arrows ----------------------------------------------------------- */
#forest-ui .unity-scroller {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

#forest-ui .unity-scroller--vertical {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin-left: 4px;
}

#forest-ui .unity-scroller .unity-scroller__low-button, #forest-ui .unity-scroller .unity-scroller__high-button, #forest-ui .unity-scroller RepeatButton {
    display: none;
}

#forest-ui .unity-scroller .unity-scroller__slider {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
}

#forest-ui .unity-scroller .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: var(--fill);
    border-radius: 3px;
}

#forest-ui .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

#forest-ui .unity-scroller .unity-base-slider__dragger {
    margin: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    background-image: none;
}

/* ---- Meters: readable on any fill (settings-a11y-7) ----------------------------------------------- */
.unity-progress-bar {
    margin: 5px 0;
    height: 24px;
}

.unity-progress-bar__background {
    background-color: var(--well);
    border-width: 0;
    border-radius: 7px;
}

.unity-progress-bar__progress {
    background-color: rgba(126, 211, 122, 0.3);
    border-radius: 7px;
}

.unity-progress-bar__title {
    -unity-font-definition: url("UI/Fonts/Manrope-ExtraBold.ttf");
    color: var(--ink);
    font-size: var(--size-button);
    text-shadow: 0 1px 2px var(--shadow-text);
}
