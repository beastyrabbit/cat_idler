/* Tethered card (GUIDE 5.5, mockups/glass.css .card). Colours are the GUIDE section 3 tokens written out; W2-13's Tokens.uss may replace them with var(). */

.tethered-card {
    position: absolute;
    width: 340px;
    padding: 14px;
    flex-direction: column;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(12, 22, 16, 0.88);
    color: rgb(238, 243, 234);
    font-size: 13px;
    overflow: hidden;
}

.tethered-card.card-compact { width: 300px; padding: 12px; }

.tethered-card.card-hidden,
.card-body.card-hidden,
.direct-control .tethered-card,
.direct-control .card-leader { display: none; }

/* Header: portrait well, name and facts, the off-screen pin and close. */
.card-head { flex-direction: row; align-items: center; flex-shrink: 0; }

.card-portrait {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 10px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.08);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.card-portrait-letter { font-size: 22px; -unity-font-style: bold; color: rgb(169, 184, 168); -unity-text-align: middle-center; }

.card-titles { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.card-name { font-size: 19px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; padding: 0; }

.card-facts { font-size: 12px; color: rgb(169, 184, 168); white-space: normal; margin: 1px 0 0 0; padding: 0; }

.tethered-card .unity-button {
    margin: 0;
    min-height: 0;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: rgb(238, 243, 234);
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 7px 11px;
}

.tethered-card .unity-button:hover { background-color: rgba(255, 255, 255, 0.14); }

.tethered-card .card-close { align-self: flex-start; width: 26px; height: 26px; padding: 0; margin-left: 6px; font-size: 15px; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: rgb(169, 184, 168); }

.tethered-card .card-pin { align-self: flex-start; padding: 4px 8px; font-size: 11px; color: rgb(255, 209, 102); border-color: rgba(255, 209, 102, 0.45); }

/* The now line and its cause. */
.card-now { margin: 12px 0 2px 0; padding: 0; font-size: 14px; -unity-font-style: bold; white-space: normal; flex-shrink: 0; }

.card-why { margin: 0 0 4px 0; padding: 0; font-size: 12px; color: rgb(169, 184, 168); white-space: normal; flex-shrink: 0; }

.card-problem { color: rgb(255, 107, 87); }

.card-scroll { flex-shrink: 1; flex-grow: 0; min-height: 0; }

.card-scroll > .unity-scroll-view__content-viewport { padding-right: 2px; }

.card-body { flex-direction: column; flex-shrink: 0; }

/* Below 1100 panel units: a full-width bottom sheet; rings sit left-aligned rather than spread. */
.card-sheet .card-rings { justify-content: flex-start; }
.card-sheet .card-ring { margin-right: 14px; }

/* Need rings: 50 px dial, 6 px track drawn by NeedRing, number in the hole, label below. */
.card-rings { flex-direction: row; justify-content: space-between; margin: 10px 0 10px 0; flex-shrink: 0; }

.card-ring { width: 64px; align-items: center; }

.card-ring-dial { width: 50px; height: 50px; border-radius: 25px; background-color: rgb(21, 34, 26); justify-content: center; align-items: center; margin-bottom: 4px; }

.card-ring-number { font-size: 13px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-center; margin: 0; padding: 0; }

.card-ring-label { font-size: 10px; -unity-font-style: bold; color: rgb(169, 184, 168); letter-spacing: 0.6px; margin: 0; padding: 0; }

.card-compact .card-ring { width: 56px; }
.card-compact .card-ring-dial { width: 44px; height: 44px; border-radius: 22px; }
.card-compact .card-ring-number { font-size: 12px; }

/* Key-value block (.kv). */
.card-kv { margin: 8px 0 8px 0; flex-shrink: 0; }

.card-kv-row { flex-direction: row; align-items: flex-start; margin: 2px 0; }

.card-kv-key { width: 92px; flex-shrink: 0; font-size: 11px; -unity-font-style: bold; color: rgb(169, 184, 168); letter-spacing: 0.6px; padding: 2px 0 0 0; margin: 0; text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }

.card-kv-value { flex-grow: 1; flex-shrink: 1; font-size: 12.5px; -unity-font-style: bold; white-space: normal; margin: 0; padding: 0; }

/* Construction checklist. */
.card-checklist { margin: 8px 0 2px 0; flex-shrink: 0; }

.card-check { flex-direction: row; align-items: center; margin: 2px 0; }

.card-check-mark { width: 18px; font-size: 13px; color: rgb(255, 209, 102); margin: 0; padding: 0; }

.card-check-done .card-check-mark { color: rgb(126, 211, 122); }

.card-check-name { flex-grow: 1; font-size: 12.5px; -unity-font-style: bold; margin: 0; padding: 0; }

.card-check-value { font-size: 12.5px; -unity-font-style: bold; color: rgb(169, 184, 168); margin: 0; padding: 0; }

.card-check-done .card-check-value { color: rgb(126, 211, 122); }

/* Progress (live-work-progress, live-build-progress). */
.card-progress { margin: 8px 0 2px 0; min-height: 0; flex-shrink: 0; }

.card-progress .unity-progress-bar__background { height: 18px; min-height: 18px; border-radius: 9px; border-width: 0; background-color: rgba(255, 255, 255, 0.10); }

.card-progress .unity-progress-bar__progress { border-radius: 9px; background-color: rgba(255, 209, 102, 0.85); }

.card-progress .unity-progress-bar__title { font-size: 11px; -unity-font-style: bold; color: rgb(26, 22, 8); }

/* Actions: up to three plus More…; one primary (sun) at most. */
.card-actions { flex-direction: row; flex-wrap: wrap; margin-top: 6px; flex-shrink: 0; }

.card-actions > * { margin: 0 6px 6px 0; }

.tethered-card .unity-button.card-primary { background-color: rgb(255, 209, 102); border-color: rgba(0, 0, 0, 0); color: rgb(26, 22, 8); }

.tethered-card .unity-button.card-primary:hover { background-color: rgb(255, 222, 140); }

.tethered-card .unity-button.card-quiet { background-color: rgba(0, 0, 0, 0); }

.tethered-card .unity-button.card-danger { color: rgb(255, 107, 87); border-color: rgba(255, 107, 87, 0.45); }

.tethered-card .unity-button:disabled { opacity: 0.45; }

.card-confirm { flex-direction: row; align-items: center; flex-wrap: wrap; }

.card-confirm > * { margin: 0 6px 6px 0; }

.card-confirm-text { font-size: 12px; -unity-font-style: bold; margin: 0 6px 6px 0; padding: 0; }

/* Assign list and More…. */
.card-list { margin: 2px 0 4px 0; flex-shrink: 0; }

.tethered-card .unity-button.card-row-act { margin: 0 0 5px 0; -unity-text-align: middle-left; white-space: normal; }

.card-more { flex-shrink: 0; margin-top: 4px; padding-right: 6px; }

.card-subtitle { font-size: 10.5px; -unity-font-style: bold; color: rgb(169, 184, 168); letter-spacing: 1.2px; margin: 10px 0 4px 0; padding: 0; }

.card-dim { font-size: 12px; color: rgb(169, 184, 168); white-space: normal; margin: 2px 0; padding: 0; }

.card-event { font-size: 11.5px; color: rgb(169, 184, 168); white-space: normal; margin: 1px 0; padding: 0; }

.card-line { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 2px 0; }

.card-line-text { flex-grow: 1; flex-shrink: 1; font-size: 12px; white-space: normal; margin: 0; padding: 0; }

.tethered-card .unity-button.card-small { padding: 3px 7px; margin: 0 0 0 4px; font-size: 11px; border-radius: 8px; }

.card-prefs { flex-direction: row; flex-wrap: wrap; }

.card-pref { width: 50%; margin: 1px 0; }

.card-pref .unity-toggle__label { font-size: 11.5px; color: rgb(238, 243, 234); min-width: 0; }

.card-pref .unity-toggle__checkmark { width: 15px; height: 15px; min-width: 15px; min-height: 15px; flex-shrink: 0; border-radius: 4px; border-width: 1px; border-color: rgba(255, 255, 255, 0.24); background-color: rgba(255, 255, 255, 0.06); -unity-background-image-tint-color: rgb(26, 22, 8); }

.card-pref:checked .unity-toggle__checkmark { background-color: rgb(255, 209, 102); border-color: rgba(0, 0, 0, 0); }

.card-pref .unity-toggle__input { flex-grow: 0; margin-left: 6px; }

.card-choice { margin: 2px 0 4px 0; }

.card-choice .unity-base-field__label { font-size: 11px; min-width: 52px; color: rgb(169, 184, 168); }
